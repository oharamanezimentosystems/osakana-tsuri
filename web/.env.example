# Firebase Web アプリ設定（Firebase コンソール → プロジェクト設定 → マイアプリ）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# デバッグ: false にすると放置30分。未設定時は true（10秒）
VITE_DEBUG=true
# デバッグ時の放置ミリ秒（既定 10000）
VITE_FISHING_MS=10000

# Cloud Functions（Blaze + Auth 有効後に true。startFishing / claimFish）
VITE_USE_FUNCTIONS=false
